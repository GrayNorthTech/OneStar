# KORTRIX ONE — Environment Variables Template
# IMPORTANT: Secrets configured in AI Studio are NOT included when you download the project.
# When deploying to your own server (cPanel, VPS, or Docker), copy this file to ".env"
# or enter these variables in your host's Node.js Environment Variables panel.

# Application Runtime
APP_URL="https://one.kortrix.com"
NODE_ENV="production"
PORT="3000"

# Database Configuration (cPanel MySQL / MariaDB)
# Leave MYSQL_HOST empty to use built-in persistent SQLite database (data/kortrix_one.db).
# Populate all MYSQL_* variables to connect directly to your cPanel MySQL database.
# Note: Use "localhost" when running on the cPanel server itself; use your cPanel public host/IP from remote cloud hosts.
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE=""
MYSQL_SSL="false"

# Authentication & Security
# Owner account identity (auto-seeded in MySQL/SQLite on server startup)
OWNER_EMAIL="dylan@kortrix.com"
OWNER_NAME="Dylan"
# Set a strong Owner password (min 12 chars). On startup, the server automatically
# hashes this passcode with salted scrypt and stores it in users.password_hash.
OWNER_ADMIN_PASSCODE=""
# Optional: set to "true" temporarily if you rotate OWNER_ADMIN_PASSCODE and want startup to overwrite users.password_hash.
OWNER_PASSCODE_SYNC="false"

# Public Website Intake API (kortrix.com -> KORTRIX ONE Service Desk)
# Clients posting to POST /api/public/service-requests must send X-Kortrix-Intake-Key.
PUBLIC_INTAKE_API_KEY=""

# Microsoft 365 / Entra ID Integration (Configure in Azure App Registration)
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_REDIRECT_URI="https://one.kortrix.com/api/auth/entra/callback"

# Finance Integrations (Planned — not active in initial version)
STRIPE_SECRET_KEY=""
SQUARE_ACCESS_TOKEN=""
